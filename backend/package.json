{
  "name": "geoguard-backend",
  "version": "1.0.0",
  "description": "GeoGuard Production Decision Support API Gateway & Microservice Orchestrator",
  "type": "module",
"scripts": {
  "dev": "tsx watch src/server.ts",
  "build": "tsc",
  "start": "node dist/server.js",
  "test": "node database_verification_suite.js",
  "db:start": "node start_postgres.js",
  "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
  "prisma:migrate": "prisma migrate dev --schema=../prisma/schema.prisma",
  "prisma:seed": "tsx ../prisma/seed.ts",
  "postinstall": "prisma generate --schema=../prisma/schema.prisma"
},
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
